<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_background" />
        </shape>
    </item>

    <item
        android:top="60dp"
        android:left="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:startColor="#388C5CF5"
                android:centerColor="#1F05B5D4"
                android:endColor="#00000000"
                android:centerX="0.35"
                android:centerY="0.35" />
        </shape>
    </item>

    <item
        android:top="360dp"
        android:right="-180dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#2905B5D4"
                android:centerColor="#1A6366F2"
                android:endColor="#00000000"
                android:centerX="0.65"
                android:centerY="0.65" />
        </shape>
    </item>
</layer-list>

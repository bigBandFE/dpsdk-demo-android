<?xml version="1.0" encoding="utf-8"?>
<!-- Matches iOS DemoDPAppButton: horizontal row with icon + text + chevron -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/home_card_bg"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/home_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        android:minHeight="104dp">

        <!-- Icon Container: 48x48, rounded 16dp, light bg -->
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/home_icon_container_bg">

            <ImageView
                android:id="@+id/card_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_icon" />
        </FrameLayout>

        <!-- Text Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="14dp">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/home_title"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/home_text"
                android:textSize="14sp" />

            <!-- AppId Badge: rounded pill, light primary bg -->
            <TextView
                android:id="@+id/card_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/home_badge_bg"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:textColor="@color/home_title"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Chevron -->
        <TextView
            android:id="@+id/card_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="›"
            android:textColor="@color/home_muted"
            android:textSize="32sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
